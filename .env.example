# Names only. This file documents configuration; do not put credentials here.

# Required for Android cloud login/sync and Supabase Edge Functions. Android
# reads its value from android/local.properties; the Supabase platform injects
# its runtime value. This root file is documentation only.
SUPABASE_URL=

# Required for Android cloud login/sync; read from android/local.properties.
SUPABASE_PUBLISHABLE_KEY=

# Optional, deployment-only. Both are needed to enable the optional plan-day
# Edge Function; if either is absent, only AI planning is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase Edge Function runtime. `SUPABASE_SECRET_KEYS` is read as a JSON
# object with a `default` server-key entry; `SUPABASE_SERVICE_ROLE_KEY` is the
# legacy fallback. Use the platform's managed server key when available. These
# values are server-only and must never be copied into Android configuration.
SUPABASE_SECRET_KEYS=
SUPABASE_SERVICE_ROLE_KEY=

# Required for internal calls to sync-push, expand-schedules, and send-reminders.
INTERNAL_FUNCTION_SECRET=

# Optional, deployment-only push delivery for send-reminders.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Google Calendar authorization is configured in Google Cloud Console for the
# Android package and signing certificate; this source does not read a Google
# OAuth client ID or client secret from an environment variable.

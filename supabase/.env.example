# Names only. Configure deployment secrets separately; never place values here.
# Supabase supplies the managed URL and service-role key to Edge Functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, deployment-only function-to-function authentication.
INTERNAL_FUNCTION_SECRET=
# Optional, deployment-only Firebase push delivery.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
